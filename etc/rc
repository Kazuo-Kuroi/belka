# /etc/rc: multi-user start-up, run by init(8) with "autoboot" when the
# system boots. It starts each script in /etc/rc.d, in the order rcorder
# gives from their PROVIDE, REQUIRE and BEFORE lines, as NetBSD's rc
# does, but for its log of the boot (/var/run/rc.log), which needs
# NetBSD's own sh. The scripts use NetBSD's rc.subr. A failure (a
# non-zero exit) leaves init in single-user mode. Settings come from
# /etc/rc.conf, which reads /etc/defaults/rc.conf first; site additions
# go in /etc/rc.local, which the local script runs.

export HOME=/
export PATH=/sbin:/usr/sbin:/usr/bin
umask 022

. /etc/rc.subr
. /etc/rc.conf
_rc_conf_loaded=true

if ! checkyesno rc_configured; then
        echo "/etc/rc.conf is not configured: staying single-user."
        exit 1
fi

if [ "$1" = autoboot ]; then
        autoboot=yes
        rc_fast=yes
fi

echo "Starting Belka multi-user."

files=$(rcorder -s nostart ${rc_rcorder_flags} /etc/rc.d/*)
for _rc_elem in $files; do
        run_rc_script $_rc_elem start
done

date
exit 0
