#
# /etc/rc: multi-user start-up, run by init(8) with "autoboot" when the
# system boots. A failure (a non-zero exit) leaves init in single-user
# mode. Settings come from /etc/rc.conf, read after the defaults in
# /etc/defaults/rc.conf; site additions go in /etc/rc.local.
#
# This is the minimal rc: there is no rc.d or rcorder yet.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
umask 022

. /etc/defaults/rc.conf
[ -f /etc/rc.conf ] && . /etc/rc.conf

if [ "$rc_configured" != YES ]; then
        echo "/etc/rc.conf is not configured: staying single-user."
        exit 1
fi

echo "Starting Belka multi-user."

# The file systems /etc/vfstab marks to be mounted at boot; then /tmp
# open to all, as it must be (a tmpfs root starts as 0755).
mount -a
chmod 1777 /tmp

# The terminal descriptions are compiled here, from their source, when
# the database is missing or older (the image carries only the source).
ti=/usr/share/misc/terminfo
if [ -f $ti ] && { [ ! -f $ti.cdb ] || [ $ti -nt $ti.cdb ]; }; then
        echo "Compiling the terminal descriptions."
        tic -x $ti
fi

if [ -f /etc/rc.local ]; then
        . /etc/rc.local
fi

exit 0
