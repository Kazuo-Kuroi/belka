# PROVIDE: manpages
# REQUIRE: mountcritlocal
# BEFORE: SERVERS

$_rc_subr_loaded . /etc/rc.subr

name="manpages"
start_cmd="manpages_start"
stop_cmd=":"

manpages_start()
{
        directory=/usr/share/man
        if [ -d "$directory" ] && [ ! -f "$directory/mandoc.db" ]; then
                echo 'Indexing the manual pages.'
                /usr/bin/makewhatis "$directory"
        fi
}

load_rc_config $name
run_rc_command "$1"
