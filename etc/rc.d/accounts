# PROVIDE: accounts
# REQUIRE: mountcritlocal
# BEFORE: SERVERS

$_rc_subr_loaded . /etc/rc.subr

name="accounts"
start_cmd="accounts_start"
stop_cmd=":"

accounts_start()
{
        if ! /usr/sbin/acctrecover; then
                stop_boot
        fi
}

load_rc_config $name
run_rc_command "$1"
