#
# dnscache(8), djbdns' caching resolver, on dnscache_ip, as the user
# dnscache, in /etc/dnscache/root: its clients' addresses are under
# ip/ (127: this host), and the servers it starts from in servers/@,
# written here at each start. With dnscache_forwarders empty, those are
# the root servers (/etc/dnscache/roots) and dnscache resolves from
# them; with a list of addresses, or "DHCP" (the name servers the
# leases offer, which dhcpcd's hook keeps in /var/db/dhcpcd/*.dns, and
# the roots while there are none), it forwards to them instead. Seeded
# from /dev/urandom; its log of queries goes to dnscache_log, and a
# fatal error to the console.

# PROVIDE: dnscache
# REQUIRE: NETWORKING mountall
# BEFORE: DAEMON

$_rc_subr_loaded . /etc/rc.subr

name="dnscache"
rcvar=$name
pidfile="/var/run/dnscache.pid"
start_cmd="dnscache_start"
stop_cmd="dnscache_stop"

# The forwarders, one to a line; nothing: resolve from the roots.
dnscache_servers()
{
        case "$dnscache_forwarders" in
        "")
                ;;
        DHCP)
                cat /var/db/dhcpcd/*.dns 2>/dev/null
                ;;
        *)
                for _s in $dnscache_forwarders; do
                        echo "$_s"
                done
                ;;
        esac
}

dnscache_start()
{
        _uid=$(id -u dnscache) && _gid=$(id -g dnscache) || return 1
        _root=/etc/dnscache/root
        _fwd=
        mkdir -p $_root/servers
        dnscache_servers > $_root/servers/@.new
        if [ -s $_root/servers/@.new ]; then
                _fwd="FORWARDONLY=1"
        else
                cp /etc/dnscache/roots $_root/servers/@.new
        fi
        mv -f $_root/servers/@.new $_root/servers/@
        echo "Starting dnscache${_fwd:+, forwarding}."
        # In the background, deaf to the console's hangup, its own stdin
        # the seed.
        (trap '' HUP; exec /bin/env -i IP="$dnscache_ip" IPSEND=0.0.0.0 \
            CACHESIZE="$dnscache_cachesize" ROOT=$_root \
            UID="$_uid" GID="$_gid" $_fwd /usr/sbin/dnscache \
            < /dev/urandom > "$dnscache_log") &
        echo $! > $pidfile
}

dnscache_stop()
{
        [ -r $pidfile ] || return 0
        echo "Stopping dnscache."
        kill $(cat $pidfile) 2>/dev/null
        rm -f $pidfile
}

load_rc_config $name
run_rc_command "$1"
