# Array boundaries used alongside GCC's exception registration CRT objects.
belka-crtbegin.o: $(srcdir)/config/belka/crtbegin.S
	$(crt_compile) -DBELKA_CRT_ARRAYS_ONLY -c $<
belka-crtend.o: $(srcdir)/config/belka/crtend.S
	$(crt_compile) -c $<
