#
# Meson cross file: mlibc for Belka on amd64, built with gcc.
# The Makefile fills in @CC@ and @CXX@, the toolchain's CC and CXX.
#
# g++ for a Linux host predefines _GNU_SOURCE in C++, which mlibc needs.
# -fno-gnu-unique: the illumos link-editor does not know the
# STB_GNU_UNIQUE binding g++ otherwise gives some template statics.

[binaries]
c = '@CC@'
cpp = '@CXX@'
ar = 'ar'
strip = 'strip'

[built-in options]
c_args = ['-fno-pic']
cpp_args = ['-fno-pic', '-fno-gnu-unique']

# muon accepts only the systems it knows here, so the system is
# 'unknown' and the Makefile picks mlibc's sysdeps with -Dsysdeps=belka.
[host_machine]
system = 'unknown'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
