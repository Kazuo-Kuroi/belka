#
# Meson cross file: mlibc for Belka on amd64, built with gcc.
#
# g++ for a Linux host predefines _GNU_SOURCE in C++, which mlibc needs.
# -fno-gnu-unique: the illumos link-editor does not know the
# STB_GNU_UNIQUE binding g++ otherwise gives some template statics.

[binaries]
c = 'gcc'
cpp = 'g++'
ar = 'ar'
strip = 'strip'

[built-in options]
c_args = ['-fno-pic']
cpp_args = ['-fno-pic', '-fno-gnu-unique']

[host_machine]
system = 'belka'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
