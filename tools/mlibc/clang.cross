#
# Meson cross file: mlibc for Belka on amd64, built with clang.
#
# clang for a bare ELF target does not predefine _GNU_SOURCE in C++, as it
# does for Linux, so it is given here: mlibc builds itself with it.

[binaries]
c = ['clang', '--target=x86_64-unknown-elf']
cpp = ['clang++', '--target=x86_64-unknown-elf']
ar = 'ar'
strip = 'strip'

[built-in options]
c_args = ['-fno-pic']
cpp_args = ['-fno-pic', '-D_GNU_SOURCE']

# muon accepts only the systems it knows here, so the system is
# 'unknown' and the Makefile picks mlibc's sysdeps with -Dsysdeps=belka.
[host_machine]
system = 'unknown'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
