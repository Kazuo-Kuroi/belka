/*
 * What the C library's view of the kernel ABI must agree on, checked
 * at build time: kernel.c expands this table against the kernel's
 * headers to record their values, and libc.c expands it against the
 * mlibc sysroot to assert that its headers give the same ones.
 *
 * CONST(name)                  a constant of the same name
 * SIZE(kstruct, lstruct)       the size of a structure
 * OFF(kstruct, kfield, lstruct, lfield)
 *                              the offset of a member
 */

