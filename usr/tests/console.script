#
# A session at the serial console, for tools/condrive (make
# test-console): log in as root on the console, which /etc/ttys marks
# secure; use the shell as a person would, with line editing, ^C and job
# control; log out and back in; and halt.

expect login:\x20 60000
send root\r
expect #\x20 15000

# /etc/profile, and the console as the terminal.
send echo "<$PATH>"\r
expect </sbin:/usr/sbin:/bin:/usr/bin>
send tty\r
expect /dev/console
send who\r
expect root
send echo $((6 * 7))\r
expect 42

# Line editing: ^P twice brings back the line before last.
send a=5\r
send echo $((a * 111))\r
expect 555
send a=7\r
send \x10\x10\r
expect 777

# ^C stops a command in the foreground; the shell carries on. (/bin/sleep:
# mksh's own sleep is built in, and runs in the shell itself.)
send /bin/sleep 30\r
sleep 1000
send \x03
expect #\x20
send echo "st=$?"\r
expect st=130

# ^Z stops it (mksh names the signal, from mlibc's strsignal); fg
# continues it; ^C ends it.
send /bin/sleep 30\r
sleep 1000
send \x1a
expect SIGTSTP
send jobs\r
expect /bin/sleep 30
send fg\r
expect /bin/sleep 30
sleep 500
send \x03
send echo "done-$((1 + 1))"\r
expect done-2

# tcsh is available from the mksh login shell. Exercise history, file
# completion, and terminal job control on the same console.
send /bin/tcsh -f\r
sleep 500
send set prompt = 'tcsh-test% '\r
expect tcsh-test%\x20
send echo tcsh-version-$version\r
expect tcsh-version-tcsh\x206.24.16
send echo tcsh-history-`echo 24`\r
expect tcsh-history-24
send \x10\r
expect tcsh-history-24
send touch /tmp/tcsh-completion-target\r
send echo /tmp/tcsh-completion-t\x09\r
expect \r\n/tmp/tcsh-completion-target
send /bin/sleep 30\r
sleep 1000
send \x1a
expect Suspended
send fg\r
expect /bin/sleep 30
sleep 500
send \x03
send echo tcsh-interrupt-$status\r
expect tcsh-interrupt-1
send exit\r
expect #\x20

# Out, and in again: init starts a new getty.
send exit\r
expect login:\x20 15000
send root\r
expect #\x20 15000
# One login on the console: init marked the last one dead (utmpx).
send echo "n=$(who | wc -l | tr -d ' ')"\r
expect n=1
send ls -l /etc/mnttab\r
expect -> ../dev/mnttab

# ps: the shell and ps itself, on the console.
send ps\r
expect \x20console\x20

# vi on the console (a vt100, from /etc/ttys): insert three lines,
# delete the first and put it after the next, substitute, and write and
# quit; the file says what was done. (A pause after escape, so that vi
# does not take what follows for the rest of a key.)
send vi /tmp/vitest\r
expect /tmp/vitest: 15000
send ione\rtwo\rthree\x1b
sleep 300
send 1Gddp
send :%s/three/3/\r
send :wq\r
expect #\x20 15000
send echo "<"$(cat /tmp/vitest)">"\r
expect <two one 3>
# Undo and a search: delete a line found by /, then u brings it back.
send vi /tmp/vitest\r
expect /tmp/vitest: 15000
send /one\rdd
send u
send :wq\r
expect #\x20 15000
send echo "n=$(wc -l < /tmp/vitest | tr -d ' ')"\r
expect n=3

# Stop the system.
send halt\r
expect halted 30000
